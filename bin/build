#!/bin/bash
# Build wrapper around xcodebuild. Exists because an environment problem
# reliably breaks this build with an error that points at the wrong culprit.
# Xcode script phases still shell out to system Ruby (bin/gen_test,
# bin/gen_html), so the guard below is still needed even though the build
# itself is no longer ninja.
#
# Ruby version managers (chruby, rbenv, rvm) export GEM_HOME/GEM_PATH into
# the environment. The build's helper scripts run under system Ruby 2.6 via
# `#!/usr/bin/env ruby`, which then tries to dlopen native gems built for a
# different Ruby and fails with:
#     Symbol not found: _rb_cArray (LoadError)
# That reads like a broken build; it is a leaked shell environment.
#
# Usage:
#   bin/build                  # build the TextMate scheme (Release)
#   bin/build <target>         # build any other Xcode target (e.g. mate)
#   bin/build <framework>/test # build <framework>_test and run it (exit
#                               # reflects pass/fail, same as the old
#                               # `ninja <framework>/test`)
set -euo pipefail

unset GEM_HOME GEM_PATH RUBYLIB RUBYOPT BUNDLE_GEMFILE

PROJECT="TextMate.xcodeproj"
CONFIGURATION="Release"
TARGET="${1:-TextMate}"

if [[ "$TARGET" == */test ]]; then
	FRAMEWORK="${TARGET%/test}"
	NAME="${FRAMEWORK}_test"
	xcodebuild -project "$PROJECT" -target "$NAME" -configuration "$CONFIGURATION" \
		build CODE_SIGNING_ALLOWED=NO
	BIN="$(xcodebuild -project "$PROJECT" -target "$NAME" -configuration "$CONFIGURATION" \
		-showBuildSettings | awk -F' = ' '/ BUILT_PRODUCTS_DIR/{print $2; exit}')/$NAME"
	# --no-parallel (long form only -- bin/gen_test's getopt string is
	# "bmpr:vhV", so -P is not actually wired despite its usage text), but
	# ONLY for the frameworks whose tests are .mm and call Cocoa APIs that
	# assert NSThread.isMainThread (e.g. TMFileReference); ninja's RunTest
	# rule forced this only for these (gen_test.sh's own comment names
	# them). Forcing it for every runner is NOT safe: it reliably breaks
	# settings_test's t_track_paths.cc, which needs real wall-clock time to
	# pass between filesystem operations across concurrently running tests
	# (found by testing: passes bare/parallel, fails 1/9 under forced
	# --no-parallel).
	case " $FRAMEWORK " in
		" buffer "|" document "|" BundlesManager "|" FileBrowser "|" ns "|" encoding "|" SoftwareUpdate "|" OakAppKit ")
			exec "$BIN" --no-parallel ;;
	esac
	exec "$BIN"
elif [ "$TARGET" = "TextMate" ]; then
	exec xcodebuild -project "$PROJECT" -scheme TextMate -configuration "$CONFIGURATION" build
else
	exec xcodebuild -project "$PROJECT" -target "$TARGET" -configuration "$CONFIGURATION" build
fi
