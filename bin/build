#!/bin/bash
# Build wrapper around xcodebuild. Exists because two things about a
# developer's shell reliably break this build, and both produce errors that
# point at the wrong culprit. Xcode script phases still shell out to system
# Ruby (bin/gen_test, bin/gen_html, bin/gen_credits.rb), so both guards below
# are still needed even though the build itself is no longer ninja.
#
# 1. Ruby version managers (chruby, rbenv, rvm) export GEM_HOME/GEM_PATH into
#    the environment. The build's helper scripts run under system Ruby 2.6 via
#    `#!/usr/bin/env ruby`, which then tries to dlopen native gems built for a
#    different Ruby and fails with:
#        Symbol not found: _rb_cArray (LoadError)
#    That reads like a broken build; it is a leaked shell environment.
#
# 2. bin/gen_credits.rb opens a DBM cache at
#    ~/Library/Caches/com.macromates.TextMate/githubcredits.db
#    If an earlier build ever ran under sudo, that file is root-owned and
#    DBM.new fails with EACCES even though the directory is yours. Deleting it
#    needs write permission on the directory, not the file, so no sudo is
#    required to clear it.
#
# Usage:
#   bin/build                  # build the TextMate scheme (Release)
#   bin/build <target>         # build any other Xcode target (e.g. mate)
#   bin/build <framework>/test # build <framework>_test and run it (exit
#                               # reflects pass/fail, same as the old
#                               # `ninja <framework>/test`)
set -euo pipefail

CACHE="$HOME/Library/Caches/com.macromates.TextMate/githubcredits.db"
if [ -e "$CACHE" ] && [ ! -O "$CACHE" ]; then
	echo "build: clearing foreign-owned credits cache at $CACHE" >&2
	rm -f "$CACHE" || {
		echo "build: could not remove $CACHE -- remove it manually and re-run." >&2
		exit 1
	}
fi

unset GEM_HOME GEM_PATH RUBYLIB RUBYOPT BUNDLE_GEMFILE

PROJECT="TextMate.xcodeproj"
CONFIGURATION="Release"
TARGET="${1:-TextMate}"

if [[ "$TARGET" == */test ]]; then
	NAME="${TARGET%/test}_test"
	xcodebuild -project "$PROJECT" -target "$NAME" -configuration "$CONFIGURATION" \
		build CODE_SIGNING_ALLOWED=NO
	BIN="$(xcodebuild -project "$PROJECT" -target "$NAME" -configuration "$CONFIGURATION" \
		-showBuildSettings | awk -F' = ' '/ BUILT_PRODUCTS_DIR/{print $2; exit}')/$NAME"
	# --no-parallel (long form only -- bin/gen_test's getopt string is
	# "bmpr:vhV", so -P is not actually wired despite its usage text):
	# some .mm runners call Cocoa APIs that assert NSThread.isMainThread
	# (e.g. TMFileReference); ninja's RunTest rule forced this for every
	# .mm runner. Forcing it here for every runner, not just .mm ones, is
	# always safe (.cc runners have no such requirement) and avoids
	# duplicating gen_test.sh's own per-framework .cc/.mm classification a
	# third place.
	exec "$BIN" --no-parallel
elif [ "$TARGET" = "TextMate" ]; then
	exec xcodebuild -project "$PROJECT" -scheme TextMate -configuration "$CONFIGURATION" build
else
	exec xcodebuild -project "$PROJECT" -target "$TARGET" -configuration "$CONFIGURATION" build
fi
