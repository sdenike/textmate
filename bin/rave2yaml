#!/System/Library/Frameworks/Ruby.framework/Versions/Current/usr/bin/ruby
# encoding: utf-8
#
# rave2yaml -- Inventory pass over the .rave build (Phase 2 Xcode migration,
# Task 1). Walks Frameworks/*/default.rave and Applications/*/default.rave
# (plus vendor/*/default.rave, reported separately -- vendor code may need
# different Xcode handling later) and prints a machine-readable list of
# every target: its kind, sources/tests globs, `require` dependencies,
# frameworks and libraries. Later tasks (project.yml generation, parity
# checking) consume this. It does NOT itself emit project.yml -- that is
# Task 4.
#
# Grammar reference: bin/rave's Parser class is the authority for what a
# .rave file may contain (see Parser#load_recursive, #flatten,
# #expand_globs and #create_targets there). Unlike bin/rave -- which on an
# unhandled directive just warns to STDERR and carries on
# (create_targets' `else` branch) -- this tool treats an unrecognised
# directive as fatal. A silently-dropped directive is how a converted
# build ends up subtly wrong, which matters more here than matching
# bin/rave's own leniency.
#
# Usage: bin/rave2yaml --inventory

require 'optparse'
require 'shellwords'
require 'fileutils'
require 'pathname'
# Deliberately NOT `require 'yaml'`: psych is a C extension, and under a
# leaked rbenv/chruby GEM_HOME/GEM_PATH (see CLAUDE.md's bin/build note)
# system Ruby 2.6 dlopens a psych built for a different Ruby and dies with
# "Symbol not found: _rb_cFalseClass" -- reproduced while building this
# tool. --emit-yaml hand-prints YAML the same way --inventory hand-prints
# its report, so it has no gem dependency to leak.

ROOT = File.expand_path('..', __dir__)
Dir.chdir(ROOT)

# Directives this tool understands, grouped by how they're handled below.
# This is the full set found by grepping every directive keyword out of
# Frameworks/*/default.rave, Applications/*/default.rave and
# vendor/*/default.rave and checking each against bin/rave's grammar --
# not the (smaller, and in two cases -- "resources"/"entitlements" --
# inaccurate) directive list in the task brief's recon notes. See
# docs/superpowers/sdd/2026-08-12-phase-2-xcode-migration/task-1-report.md.
#
# Directives bin/rave supports but that never appear in this tree --
# load, extend, arch, notarize, define, and prelude outside the root
# default.rave -- are deliberately NOT implemented; encountering one
# falls through to the "unrecognised directive" error below rather than
# being silently mishandled.
GLOB_DIRECTIVES   = %w[headers sources tests cxx_tests].freeze   # dir-relative glob patterns
LIST_DIRECTIVES   = %w[require require_headers frameworks libraries].freeze # space-separated names
SCALAR_DIRECTIVES = %w[executable prefix].freeze                 # single value, ${var}-expanded
INERT_DIRECTIVES  = %w[set add capture expand files copy].freeze # recognised; not surfaced below
BLOCK_DIRECTIVES  = %w[target config].freeze                     # may open a `{ ... }` body

class RaveError < StandardError; end

# One `target "name" { ... }` block.
Target = Struct.new(:name, :vendor, :file, :line, :lists, :scalars) do
  def initialize(name, vendor, file, line)
    super(name, vendor, file, line, Hash.new { |h, k| h[k] = [] }, {})
  end
end

# ${name} / $name substitution, matching bin/rave's VARIABLE_MATCH. Only
# the handful of variables actually used in this tree (dirname, dir,
# target) are known; anything else is a hard error rather than being
# left unresolved in the output -- bin/rave itself aborts on an unknown
# variable (Parser#expand_variables), and silently emitting "${FOO}"
# into a sources glob would be exactly the kind of quiet wrongness this
# tool exists to avoid.
def resolve(str, vars, file, line)
  str.gsub(/\$\{(\w+)\}|\$(\w+)/) do
    name = $1 || $2
    vars.fetch(name) do
      raise RaveError, "#{file}:#{line}: unresolved variable '#{name}' in '#{str}'"
    end
  end
end

# Matches bin/rave's own line grammar (Parser#load_recursive) exactly:
# a line is a close brace, a comment, or `word args... {`? -- nothing else
# is syntactically valid. Blank lines match none of these and are skipped
# by the caller before this is applied, same as bin/rave.
LINE_RE = /^\s*(?:(\})|(#.*)|([a-z_]+)\s*(.+?)\s*(\{)?)\s*$/.freeze

def parse_file(path, vendor:)
  dir     = File.dirname(path)
  dirname = File.basename(dir)
  vars    = { 'dir' => dir, 'dirname' => dirname }

  targets = []
  target  = nil # current Target, nil outside any `target` block

  # Names of currently-open `config { }` blocks, innermost last; also
  # doubles as a depth counter (config_stack.empty? == not inside one).
  # Both real config blocks in this tree (Applications/TextMate debug/
  # release) contain only `add PLIST_FLAGS`, an INERT_DIRECTIVES member --
  # but that's verified below, not assumed: a GLOB/LIST/SCALAR directive
  # inside a config block errors rather than silently merging into the
  # enclosing target's unconditional fields as though it applied to every
  # configuration (--inventory has no per-config representation to merge
  # it into correctly).
  config_stack = []

  File.readlines(path).each_with_index do |raw, idx|
    line   = raw.chomp
    lineno = idx + 1
    next if line.strip.empty?

    m = LINE_RE.match(line)
    raise RaveError, "#{path}:#{lineno}: cannot parse line: #{raw.inspect}" unless m

    close_brace, comment, command, params, open_brace = m.captures
    next if comment

    if close_brace
      if !config_stack.empty?
        config_stack.pop
      elsif target
        targets << target
        target = nil
      else
        raise RaveError, "#{path}:#{lineno}: unmatched '}'"
      end
      next
    end

    args = Shellwords.split(params)

    if open_brace
      case command
      when 'target'
        raise RaveError, "#{path}:#{lineno}: nested 'target' block (already inside #{target.name})" if target
        raw_name = args.fetch(0) { raise RaveError, "#{path}:#{lineno}: 'target' needs a name" }
        target = Target.new(resolve(raw_name, vars, path, lineno), vendor, path, lineno)
      when 'config'
        raise RaveError, "#{path}:#{lineno}: 'config' outside a target block" unless target
        config_name = args.fetch(0) { raise RaveError, "#{path}:#{lineno}: 'config' needs a name" }
        config_stack.push(config_name)
      else
        raise RaveError, "#{path}:#{lineno}: unrecognised directive '#{command}' " \
                          '(only target/config may open a { } block)'
      end
      next
    end

    raise RaveError, "#{path}:#{lineno}: directive '#{command}' outside a target block" unless target

    tvars = vars.merge('target' => target.name)

    scoped = GLOB_DIRECTIVES.include?(command) || LIST_DIRECTIVES.include?(command) ||
             SCALAR_DIRECTIVES.include?(command)
    if scoped && !config_stack.empty?
      raise RaveError, "#{path}:#{lineno}: '#{command}' is config-scoped (inside " \
                        "config #{config_stack.join(' > ')} for target #{target.name}); " \
                        "--inventory has no per-config representation, so merging it into " \
                        "the target's unconditional fields would silently misreport which " \
                        'configuration it applies to -- move it out of the config block, ' \
                        'or extend rave2yaml to carry config scope through to the inventory'
    end

    if GLOB_DIRECTIVES.include?(command)
      target.lists[command] += args.map { |a| File.join(dir, resolve(a, tvars, path, lineno)) }
    elsif LIST_DIRECTIVES.include?(command)
      target.lists[command] += args.map { |a| resolve(a, tvars, path, lineno) }
    elsif SCALAR_DIRECTIVES.include?(command)
      target.scalars[command] = resolve(args.join(' '), tvars, path, lineno)
    elsif INERT_DIRECTIVES.include?(command)
      # set/add/capture/expand are variable plumbing that never reaches
      # sources/require/frameworks/libraries in this tree; files/copy are
      # Resources bundling. Recognised so real content doesn't trip the
      # "unrecognised directive" error; not part of the fields --inventory
      # reports because none of it feeds kind/sources/require/tests/
      # frameworks/libraries here (see the task-1 report for the grep that
      # checked this).
    else
      raise RaveError, "#{path}:#{lineno}: unrecognised directive '#{command}'"
    end
  end

  raise RaveError, "#{path}: unterminated block (missing '}')" if target || !config_stack.empty?

  targets
end

def kind_of(target)
  exe = target.scalars['executable']
  return 'framework' unless exe

  case target.scalars['prefix']
  when nil               then 'tool'
  when /\.app\//         then 'app'
  when /\.xpc\//         then 'xpc'
  when /\.qlgenerator\// then 'qlgenerator'
  else 'bundle'
  end
end

def print_glob_field(io, target, key)
  globs = target.lists[key]
  return if globs.empty?

  count = globs.sum { |g| Dir.glob(g).length }
  io.puts "  #{key} #{globs.join(' ')} (#{count} #{count == 1 ? 'file' : 'files'})"
end

def print_target(io, target, label)
  io.puts "#{label} #{target.name}"
  io.puts "  kind #{kind_of(target)}"
  io.puts "  file #{target.file}:#{target.line}"
  io.puts "  executable #{target.scalars['executable']}" if target.scalars['executable']
  io.puts "  prefix #{target.scalars['prefix']}" if target.scalars['prefix']
  io.puts "  requires #{target.lists['require'].join(' ')}" unless target.lists['require'].empty?
  unless target.lists['require_headers'].empty?
    io.puts "  requires-headers #{target.lists['require_headers'].join(' ')}"
  end
  io.puts "  headers #{target.lists['headers'].join(' ')}" unless target.lists['headers'].empty?
  print_glob_field(io, target, 'sources')
  print_glob_field(io, target, 'tests')
  print_glob_field(io, target, 'cxx_tests')
  io.puts "  frameworks #{target.lists['frameworks'].join(' ')}" unless target.lists['frameworks'].empty?
  io.puts "  libraries #{target.lists['libraries'].join(' ')}" unless target.lists['libraries'].empty?
  io.puts
end

def run_inventory(io)
  main_files   = Dir.glob('{Frameworks,Applications,PlugIns}/*/default.rave').sort
  vendor_files = Dir.glob('vendor/*/default.rave').sort

  main_targets   = main_files.flat_map { |f| parse_file(f, vendor: false) }.sort_by(&:name)
  vendor_targets = vendor_files.flat_map { |f| parse_file(f, vendor: true) }.sort_by(&:name)

  io.puts "# rave2yaml inventory: #{main_targets.length} targets from " \
          "#{main_files.length} Frameworks/Applications/PlugIns default.rave files, " \
          "#{vendor_targets.length} vendor targets from #{vendor_files.length} vendor/ files"
  io.puts '# generated by bin/rave2yaml --inventory; see --emit-yaml for project.yml emission'
  io.puts

  main_targets.each { |t| print_target(io, t, 'target') }

  unless vendor_targets.empty?
    io.puts '# vendor targets (vendor/*/default.rave) -- noted separately: third-party code that' \
            ' may need different Xcode handling than first-party Frameworks/Applications targets.' \
            ' Still real `require` targets (e.g. Applications/TextMate requires "kvdb"), so their' \
            ' names are valid dependency-resolution targets too.'
    vendor_targets.each { |t| print_target(io, t, 'vendor-target') }
  end
end

# ---------------------------------------------------------------------------
# --emit-header-farm: a committed symlink farm so any Xcode target can see a
# framework's (or vendor target's) headers as <name>/<header>.h without a
# copy step.
#
# rave's ExportHeader rule (docs/benchmarks/2026-08-12-header-strategy.md)
# does this with a real build rule -- cp Frameworks/<n>/src/x.h to
# _Include/<n>/<n>/x.h, ONE FILE AT A TIME, from the target's `headers` glob
# (docs/benchmarks/2026-08-12-header-strategy.md's ExportHeader section, and
# bin/rave:820 `if headers = target[:headers]`). That glob is often a
# NARROWER list than "every .h in src/" -- e.g. `Frameworks/settings/src/`
# has 4 headers but `settings`' `headers` directive names only 2
# (settings.h, keys.h; parser.h and track_paths.h are private). The original
# Task 4 farm symlinked the whole `src` DIRECTORY per framework, which is
# MORE permissive than rave: every framework's private headers become
# reachable by any consumer, silently destroying the same kind of
# compiler-enforced isolation the per-target HEADER_SEARCH_PATHS design
# (Base.xcconfig) exists to preserve. See
# docs/benchmarks/2026-08-12-header-strategy.md's "Fidelity: declared
# headers vs. whole src/" section for the decision. Fixed here: one relative
# symlink per DECLARED header (via each target's own `headers` glob,
# resolved through the same parser --inventory/--emit-yaml use), landing at
# Xcode/include/<name>/<name>/<basename>.h -- matching ExportHeader's output
# path and its file-at-a-time granularity, just via symlinks instead of a
# build rule (valid the moment the tree is checked out, no build step
# needed). Covers both Frameworks/*/ and vendor/*/ (kvdb/Onigmo/xdiff also
# export headers, e.g. `<Onigmo/oniguruma.h>` from regexp's sources) -- the
# same universe --emit-yaml can target. Rerun this instead of hand-editing
# symlinks; a target's stale/removed headers are pruned automatically.
def run_header_farm(io)
  root    = 'Xcode/include'
  by_name = all_targets_by_name
  targets = by_name.values.select { |t| t.file.start_with?('Frameworks/', 'vendor/') }
                    .sort_by(&:name)

  total = 0
  targets.each do |target|
    dir = File.join(root, target.name, target.name)

    # Migration guard: Task 4's farm made `dir` itself a symlink straight at
    # Frameworks/<name>/src. If left in place, `mkdir_p` treats an existing
    # symlink-to-a-directory as "already exists" and skips creating a real
    # directory there, so the pruning loop below would resolve THROUGH the
    # old symlink and start deleting real files under Frameworks/<name>/src.
    # Unlink it first so `dir` becomes a real, empty directory this run owns.
    FileUtils.rm_f(dir) if File.symlink?(dir)
    FileUtils.mkdir_p(dir)

    files = target.lists['headers'].flat_map { |g| Dir.glob(g) }.sort.uniq
    keep  = files.map { |f| File.basename(f) }
    Dir.children(dir).each { |entry| FileUtils.rm_f(File.join(dir, entry)) unless keep.include?(entry) }

    files.each do |f|
      link        = File.join(dir, File.basename(f))
      relative_to = Pathname.new(f).relative_path_from(Pathname.new(dir)).to_s
      next if File.symlink?(link) && File.readlink(link) == relative_to
      FileUtils.rm_f(link)
      File.symlink(relative_to, link)
      total += 1
    end
  end

  io.puts "rave2yaml: wrote #{total} header symlinks across #{targets.length} targets under #{root}/"
end

# ---------------------------------------------------------------------------
# --emit-yaml <target>...: an XcodeGen project.yml for exactly the named
# targets plus their transitive `require` closure -- Task 4's pilot, and the
# pattern Task 5 repeats for the other 45 frameworks.
#
# Each `framework`-kind target (kind_of) becomes a `library.static` Xcode
# target. One that declares `tests` also gets a `<name>_test` `tool`
# companion that generates its CxxTest runner via Xcode/scripts/gen_test.sh
# (mirroring build.ninja's GenTest rule) and links the framework plus the
# `frameworks`/`libraries` (e.g. `frameworks CoreFoundation`, `libraries
# iconv`) declared across the closure -- those only matter at final link
# time, never at compile time (see the header-strategy doc), so they belong
# on the test tool, not the static lib.
#
# Deliberately narrow, same fail-loud stance as --inventory (see file
# header): any target in the closure that isn't `framework` kind, that
# lives under vendor/ without a VENDOR_EXTRA entry (see checked_target), or
# that uses a directive this tool doesn't translate, raises rather than
# being silently dropped or guessed at. Empty now -- require_headers
# (transitive_header_deps) and cxx_tests (the skip-comment in
# emit_library_target) are both handled as of Task 5 -- but kept as a named,
# checked constant rather than deleted so a future directive this tree
# starts using lands here first, not silently.
UNTRANSLATED_DIRECTIVES = %w[].freeze

# vendor/*/default.rave (kvdb, Onigmo, xdiff) diverges from the
# Frameworks/<name>/src/ convention this tool otherwise assumes: explicit,
# non-src/ source and header paths, and a per-target `add FLAGS`/`add
# C_FLAGS` whose CONTENT this parser's INERT_DIRECTIVES set recognises the
# line but doesn't record (see INERT_DIRECTIVES above -- `add` is variable
# plumbing, never needed until now). Read by hand, once, straight out of
# each vendor target's own default.rave rather than taught to the parser
# generically, since there are exactly three and each is a one-off shape:
#
#   vendor/kvdb/default.rave    -- no `add` lines at all.
#   vendor/Onigmo/default.rave  -- add FLAGS   "-I${dir} -I${dir}/vendor"
#                                   add C_FLAGS "-Wno-incompatible-pointer-types -Wno-char-subscripts"
#   vendor/xdiff/default.rave   -- add FLAGS   "-I${dir}/src"
#                                   add C_FLAGS "-Wno-sign-compare -Wno-shorten-64-to-32 -Wno-implicit-int-conversion"
#
# `add FLAGS "-I..."` is target-scoped in rave (`add` sets a variable on
# that target only; bin/rave:283-287), so these paths apply ONLY to the
# vendor target's own compile, never propagated to consumers (regexp,
# scm) -- consumers instead reach the vendor target's exported headers via
# the ordinary HEADER_SEARCH_PATHS/farm mechanism like any other `require`.
# `add C_FLAGS` maps to Xcode's OTHER_CFLAGS: both Onigmo and xdiff compile
# only `.c` (bin/rave:573-576 keys C-only flags off `.c`'s own C_FLAGS
# variable, never `.m`'s OBJC_FLAGS), so a target-scoped OTHER_CFLAGS can't
# leak into any other language's compile within that same target.
#
# A vendor target missing here raises in checked_target instead of being
# guessed at -- preserves the fail-loud guard's spirit (04ac5128) for any
# future vendor addition this table hasn't been taught about yet.
VENDOR_EXTRA = {
  'kvdb'   => { search_paths: [], other_cflags: nil },
  'Onigmo' => {
    search_paths: %w[$(SRCROOT)/vendor/Onigmo $(SRCROOT)/vendor/Onigmo/vendor],
    other_cflags: '-Wno-incompatible-pointer-types -Wno-char-subscripts',
  },
  'xdiff' => {
    search_paths: %w[$(SRCROOT)/vendor/xdiff/src],
    other_cflags: '-Wno-sign-compare -Wno-shorten-64-to-32 -Wno-implicit-int-conversion',
  },
}.freeze

def all_targets_by_name
  # PlugIns/*/default.rave (Dialog, Dialog2 -- Task 1 confirmed both use only
  # already-implemented directives) is walked here but deliberately NOT by
  # run_header_farm (Frameworks/vendor only, see its own comment): neither
  # plugin ever exports headers to another target.
  main_files   = Dir.glob('{Frameworks,Applications,PlugIns}/*/default.rave').sort
  vendor_files = Dir.glob('vendor/*/default.rave').sort
  targets = main_files.flat_map { |f| parse_file(f, vendor: false) } +
            vendor_files.flat_map { |f| parse_file(f, vendor: true) }

  by_name = {}
  targets.each do |t|
    prior = by_name[t.name]
    raise RaveError, "duplicate target '#{t.name}': #{prior.file}:#{prior.line} and #{t.file}:#{t.line}" if prior
    by_name[t.name] = t
  end
  by_name
end

# Kinds --emit-yaml can translate when they appear as the WALK'S OWN
# starting point (a CLI-given name, or an EMBED entry -- see below): the
# app itself, its two plugin bundles, its QuickLook generator, and the
# plain-executable tools it embeds or that embed each other. Anything
# reached via an ordinary `require`/`require_headers` EDGE must still be
# 'framework' (rave's own require graph never points at a non-framework --
# nothing in this tree requires a tool/bundle/app/qlgenerator target -- so
# this is enforcement, not a hypothetical), which is why this set is only
# consulted when `top_level:` is true rather than folded into `kind_of`
# itself.
TOP_LEVEL_KINDS = %w[framework tool bundle qlgenerator app].freeze

def checked_target(name, by_name, top_level: false)
  target = by_name.fetch(name) { raise RaveError, "--emit-yaml: unknown target '#{name}'" }
  # vendor/*/default.rave targets (kvdb, Onigmo, xdiff) declare no
  # `executable`, so kind_of returns 'framework' and they'd otherwise sail
  # past the kind check below without the divergent bits (explicit
  # sources/headers paths, add-FLAGS) ever being accounted for -- the exact
  # silent-gap the task-4 report flagged. Caught here: any vendor target
  # without a VENDOR_EXTRA entry raises before the kind check runs, so the
  # reason reported is about vendor divergence, not a bogus kind mismatch.
  if target.vendor && !VENDOR_EXTRA.key?(name)
    raise RaveError, "--emit-yaml: #{name}: vendor target (#{target.file}:#{target.line}) has no " \
                      "VENDOR_EXTRA entry -- vendor/*/default.rave targets carry per-target 'add " \
                      "FLAGS'/'add C_FLAGS' content this parser doesn't record generically (see " \
                      "the comment above VENDOR_EXTRA), so each one is translated by hand. Add " \
                      "#{name} to VENDOR_EXTRA once its .rave file's exact shape has been read."
  end
  allowed = top_level ? TOP_LEVEL_KINDS : %w[framework]
  unless allowed.include?(kind_of(target))
    raise RaveError, "--emit-yaml: #{name}: kind '#{kind_of(target)}' is not yet " \
                      "translated (#{allowed.join('/')} #{allowed.length == 1 ? 'is' : 'are'})"
  end
  UNTRANSLATED_DIRECTIVES.each do |directive|
    next if target.lists[directive].empty?
    raise RaveError, "--emit-yaml: #{name}: '#{directive}' is declared but not yet translated"
  end
  target
end

# Every name transitively reachable from `name` via `require`, NOT
# including `name` itself. This is the LINK closure: matches bin/rave's
# executable()/test-link steps (bin/rave:901, :1418), which call
# required_targets WITHOUT include_weak, so a `require_headers` edge never
# appears here. Validates every target it walks through (via
# checked_target), so a bad target fails loudly instead of being silently
# skipped.
#
# `root:` guards against a real cycle in this tree's require graph (plist
# require io, io require ns, ns require plist) feeding the STARTING name
# back into its own closure: without it, `transitive_requires('plist', ...)`
# would put 'plist' in its own `seen` (the `next if seen.key?(dep)` guard
# only de-duplicates repeats, it doesn't know 'plist' was the root), and a
# caller doing `deps.each { |d| puts "- target: #{d}" }` right after an
# unconditional `- target: #{name}` line would then emit `plist` as its own
# dependency twice. `root:` defaults to `name` on the outer call and is
# threaded unchanged through every recursive call, so the one name that
# must never appear in the result is fixed for the whole walk regardless of
# how many cycles route back to it.
#
# `top_level:` is threaded through as `name == root`: true on exactly the
# one call in a given walk where `name` is the walk's own starting point
# (every recursive call's `dep` was already checked `!= root` before the
# call, per the cycle guard above), which is the only point a non-framework
# kind (tool/bundle/app/qlgenerator) may legally appear -- see
# checked_target's TOP_LEVEL_KINDS comment.
def transitive_requires(name, by_name, seen = {}, root: name)
  checked_target(name, by_name, top_level: name == root).lists['require'].each do |dep|
    next if dep == root || seen.key?(dep)
    seen[dep] = true
    transitive_requires(dep, by_name, seen, root: root)
  end
  seen
end

# Every name transitively reachable from `name` via `require` OR
# `require_headers`, NOT including `name` itself. This is the COMPILE
# closure: matches bin/rave's required_targets(..., include_weak: true)
# (bin/rave:786-806), used to build a target's own HEADER_SEARCH_PATHS
# (objects(), bin/rave:853) and a test runner's (bin/rave:1409).
# require_headers is a WEAK, header-only edge -- add the dependency's farm
# directory to HEADER_SEARCH_PATHS, never a `dependencies:` link entry --
# but bin/rave keeps following BOTH require and require_headers at every
# node the walk discovers, not just at the start (`required_target[:require]`
# and `required_target[:require_headers]` are both re-queued unconditionally
# once include_weak is true), so this closure is always a superset of
# transitive_requires's. The three real users: OakDebug require_headers
# text, Preferences require_headers OakTabBarView, TMFileReference
# require_headers scm (which itself pulls in scm's own `require text cf io
# settings regexp xdiff`, and regexp's `require Onigmo text cf`, all
# transitively, header-only). CommitWindowTool's `require_headers
# CommitWindow` is NOT this kind of case: CommitWindowTool is a `tool`
# (declares `executable`), not a `framework`, so checked_target rejects it
# and it never appears as a `name` or `dep` here -- nothing `require`s a
# tool. It is a real no-op for --emit-yaml's framework-only graph.
# `root:` guards the same require-graph cycle transitive_requires does (see
# its comment) -- it reaches transitive_header_deps too, since every
# require edge is also a header edge.
def transitive_header_deps(name, by_name, seen = {}, root: name)
  target = checked_target(name, by_name, top_level: name == root)
  (target.lists['require'] + target.lists['require_headers']).each do |dep|
    next if dep == root || seen.key?(dep)
    seen[dep] = true
    transitive_header_deps(dep, by_name, seen, root: root)
  end
  seen
end

# YAML double-quoted scalar. Used for every interpolated value (paths,
# names, script text) so `$(...)`  build-setting macros and the quotes in
# the preBuildScripts command line never need case-by-case judgement about
# whether plain-scalar YAML would also have been safe.
def yq(value)
  escaped = value.to_s.gsub('\\') { '\\\\' }.gsub('"') { '\\"' }
  "\"#{escaped}\""
end

PRELUDE_FOR_EXT = { '.c' => 'prelude.c', '.m' => 'prelude.m', '.cc' => 'prelude.cc', '.mm' => 'prelude.mm' }.freeze

# Resolves a target's raw (dir-joined) glob patterns to a sorted, deduped
# file list -- the same `Dir.glob` bin/rave itself uses (Parser#expand_globs),
# so this agrees with what rave would actually compile/export.
def resolved(globs)
  globs.flat_map { |g| Dir.glob(g) }.sort.uniq
end

# Prints one target's `sources:` block from an explicit, already-resolved,
# non-.rl file list, and returns the GCC_PREFIX_HEADER value its `settings:`
# should use -- or nil, meaning the caller must NOT emit a GCC_PREFIX_HEADER
# key at all (see the mixed case below).
#
# ALWAYS an explicit per-file list, never a directory `path:` reference --
# found by a real Task 5 build failure, not a style preference.
# Frameworks/FileBrowser/src/drivers is a pre-existing symlink to
# Frameworks/scm/src/drivers (predates this migration); rave's own
# `sources src/*.mm src/OFB/*.mm` glob never traverses into it, so rave
# never compiles anything through it, but XcodeGen's directory `path:`
# entries recurse through the whole tree INCLUDING symlinked
# subdirectories, silently pulling scm's own driver sources into
# FileBrowser too (manifested first as a spurious "prelude.mm required by
# .../drivers/api.cc" PCH request, since api.cc is plain C++ inside an
# otherwise all-.mm target). An explicit file list built from the same
# resolved `sources` glob rave itself uses can't over-include this way --
# whatever rave would compile is exactly and only what Xcode compiles.
# This also makes the separate headerVisibility workaround this comment
# used to describe unnecessary: with only .cc/.m/.mm/.c files ever listed
# (never a directory that could also contain .h files), Xcode's
# Headers-phase public-copy step -- the one that shadowed Apple's
# Network.framework with Frameworks/network's own headers, see the
# 04ac5128-era finding -- has nothing to act on in the first place.
#
# Homogeneous (.cc-only, .mm-only, .m-only, or .c-only -- the only shapes
# 39 of the 46 frameworks and all 3 vendor targets have): one prelude via
# the ordinary GCC_PREFIX_HEADER + GCC_PRECOMPILE_PREFIX_HEADER=YES
# (Base.xcconfig) mechanism, matching rave's own Compiler.transform choice
# (bin/rave:596) since every compiled file shares the same language.
#
# Mixed .cc + .mm (BundleEditor, OakDebug, command, document, io, plist,
# theme -- confirmed the only mixed combination in this tree): rave compiles
# each file with ITS OWN matching prelude (bin/rave:596,
# `prelude.find { |file| File.extname(file) == @canonical_ext }`), but
# Xcode's GCC_PREFIX_HEADER is one value per TARGET, not per file, and a
# single prelude never works for both at once -- verified by direct clang
# invocation (see docs/benchmarks/2026-08-12-header-strategy.md): prelude.mm
# (has Cocoa) fails `-x c++` outright with real Objective-C parse errors
# from inside Foundation's own headers, since plain C++ mode can't parse
# `@interface` etc; prelude.cc (no Cocoa) compiles under `-x objective-c++`
# but supplies nothing Cocoa, so .mm files relying on the prefix header for
# their Cocoa types (e.g. Frameworks/OakDebug/src/OakAssert.mm's
# `@interface ... : NSObject` with no Cocoa import of its own) fail on
# "undeclared identifier 'NSObject'".
#
# First fix attempt -- keep GCC_PREFIX_HEADER=prelude.cc at the target level
# (automatic PCH) and layer a second, forced `-include prelude.mm` onto just
# the .mm files via `compilerFlags:` -- looked right in isolation but FAILED
# a real build (Frameworks/theme): clang only honours the PRECOMPILED (.gch)
# form of the FIRST `-include` on a command line. Xcode still appends its
# own automatic `-include` for GCC_PREFIX_HEADER after the compilerFlags one,
# so it lands SECOND and clang falls back to a literal textual include of
# that path -- but the path Xcode generates there is its internal
# SharedPrecompiledHeaders cache location, not the real source file, so it
# doesn't exist as plain text: "clang: warning: precompiled header
# '.../prelude.cc.gch' was ignored because '-include .../prelude.cc' is not
# first '-include'" immediately followed by "fatal error: '.../prelude.cc'
# file not found". No ordering of two `-include`s where one is automatic
# avoids this.
#
# Actual fix: for a mixed target, GCC_PREFIX_HEADER is left UNSET (this
# method returns nil) so Xcode never generates its own automatic -include at
# all, and BOTH sources: entries force their own prelude explicitly via
# `compilerFlags:` instead -- one `-include` per file, always textual (no
# precompilation, so a little slower, but correct), always the right
# language. Verified end to end in a scratch XcodeGen project before
# reapplying here: two source groups, each with its own forced `-include`
# and no target-level GCC_PREFIX_HEADER at all, both compiled with the
# correct macro visible and neither warning/erroring.
def choose_prefix_header(exts, context)
  case exts.length
  when 0, 1
    "$(SRCROOT)/Shared/PCH/#{PRELUDE_FOR_EXT.fetch(exts.first, 'prelude.cc')}"
  else
    # Mixed: no target-level prefix header; every sources: group forces its
    # own via compilerFlags (see the long comment above). Generalised from
    # the original .cc+.mm-only case (7 frameworks) to any 2+ combination of
    # known extensions -- Task 6's TextMateQL (`src/*.{c,mm}`) is the first
    # .c+.mm user, and the per-file mechanism doesn't care how many groups
    # there are, only that each file's OWN extension picks its OWN prelude.
    unknown = exts - PRELUDE_FOR_EXT.keys
    if unknown.any?
      raise RaveError, "--emit-yaml: #{context}: source extensions #{unknown.inspect} have no " \
                        'prelude mapping (only .c/.m/.cc/.mm are handled)'
    end
    nil
  end
end

# One `- path:` entry per file, in `files` order (caller sorts). Mixed
# .cc+.mm splits into two groups purely by partitioning the already-resolved
# file list (no XcodeGen includes:/excludes: glob needed, since there's no
# directory entry for a glob to filter in the first place), each forced onto
# its own prelude via `compilerFlags:` -- see choose_prefix_header's comment
# for why this must be a plain forced -include rather than the automatic
# GCC_PREFIX_HEADER mechanism.
def emit_source_file_group(io, files, compiler_flags: nil)
  files.each do |f|
    io.puts "      - path: #{yq(f)}"
    io.puts "        compilerFlags: #{yq(compiler_flags)}" if compiler_flags
  end
end

def emit_sources(io, files)
  exts          = files.map { |f| File.extname(f) }.uniq.sort
  prefix_header = choose_prefix_header(exts, files.first)
  io.puts '    sources:'
  if exts.length > 1
    # One group per extension actually present (was hardcoded to exactly
    # .cc+.mm; generalised for TextMateQL's .c+.mm -- see choose_prefix_header).
    exts.each do |ext|
      group = files.select { |f| f.end_with?(ext) }
      emit_source_file_group(io, group, compiler_flags: "-include $(SRCROOT)/Shared/PCH/#{PRELUDE_FOR_EXT.fetch(ext)}")
    end
  else
    emit_source_file_group(io, files)
  end
  prefix_header
end

def header_search_paths_line(header_deps, extra_paths: [])
  paths = ['$(inherited)'] + extra_paths + header_deps.map { |d| "$(SRCROOT)/Xcode/include/#{d}" }
  "        HEADER_SEARCH_PATHS: #{yq(paths.join(' '))}"
end

# cxx_tests is glob-expanded by bin/rave (bin/rave:137) exactly like
# sources/tests/headers, but Task 1 confirmed it has NO consumer anywhere
# else in bin/rave -- the ninja build never compiles or runs whatever it
# names. Translating it would ADD tests the current build never ran, a
# behaviour change, not parity (this task's own brief is explicit on that
# point). Neither failing loud nor staying silent is right for dead-but-real
# metadata, so it's a deliberate, visible skip: a comment in the emitted
# YAML naming the count, plus this same explanation surfaced in the task
# report. Users in this tree: ns, layout, OakAppKit (all tests/gui_*.mm).
def emit_cxx_tests_skip_comment(io, target)
  return if target.lists['cxx_tests'].empty?
  count = resolved(target.lists['cxx_tests']).length
  io.puts "  # #{target.name}: cxx_tests declares #{count} file#{count == 1 ? '' : 's'} but bin/rave " \
          "has no consumer for target[:cxx_tests] outside its own glob-expand step (bin/rave:137) " \
          "-- the ninja build never compiles or runs them. Deliberately NOT translated: doing so " \
          "would add tests the current build never ran, a behaviour change, not parity."
end

def emit_library_target(io, target, header_deps)
  name = target.name

  emit_cxx_tests_skip_comment(io, target)

  all_sources = resolved(target.lists['sources'])
  ragel       = all_sources.select { |f| f.end_with?('.rl') }
  sources     = all_sources - ragel

  io.puts "  #{name}:"
  io.puts '    type: library.static'
  io.puts '    platform: macOS'
  prefix_header = emit_sources(io, sources)
  # ragel output is always .cc (bin/rave:635-636, `transforms '.rl' =>
  # '.cc'`), and its sources: entry is its own separate group -- if the
  # target has no automatic target-level PCH (prefix_header nil: the mixed
  # .cc+.mm case), this group needs the same explicit forced -include the
  # other two groups get, or it compiles with no prelude content at all
  # ("unknown type name 'va_list'" etc -- a real Task 5 build failure, not
  # a hypothetical). If the target DOES have a target-level PCH (the
  # homogeneous case -- not exercised by anything in this tree today, since
  # plist is the only Ragel user and it's mixed), that PCH already covers
  # this .cc file automatically and adding a second forced -include here
  # would reproduce the exact "not first -include" break documented above
  # choose_prefix_header -- so only add it when prefix_header is nil.
  emit_ragel_generated_sources(io, name, ragel, force_include: prefix_header.nil?)
  emit_ragel_prebuild_script(io, name, ragel) unless ragel.empty?

  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq(prefix_header)}" if prefix_header
  io.puts header_search_paths_line(header_deps) unless header_deps.empty?
end

# ascii.rl (Frameworks/plist/src/ascii.rl) is the only Ragel source in the
# Frameworks/vendor graph (bin/rave's CompileRagel: `transforms '.rl' =>
# '.cc'`, bin/rave:635-636) -- handled generically here, keyed off the
# resolved source list's own extension rather than the framework's name, so
# a second Ragel file anywhere else in the tree would pick this up too
# instead of needing its own special case.
def emit_ragel_generated_sources(io, name, ragel_files, force_include:)
  ragel_files.each do |rl|
    base = File.basename(rl, '.rl')
    # bin/rave's CompileRagel adds `-iquote <dirname of the .rl file>`
    # (bin/rave:643, threaded through Compiler.transform's chaining at
    # bin/rave:497-509) to whatever compiles ITS OWN output, because the
    # generated .cc textually carries the original file's `#include "…"`
    # lines (ascii.rl's `#include "ascii.h"`) unchanged, and a QUOTED
    # include resolves relative to the compiled file's real on-disk
    # location -- which for a $(DERIVED_FILE_DIR) output is nowhere near
    # Frameworks/plist/src, unlike the -iquote'd original directory.
    # Without this: "fatal error: 'ascii.h' file not found", a real Task 5
    # build failure, not a hypothetical.
    flags = ["-iquote $(SRCROOT)/#{File.dirname(rl)}"]
    flags << '-include $(SRCROOT)/Shared/PCH/prelude.cc' if force_include
    io.puts "      - path: #{yq("$(DERIVED_FILE_DIR)/_R#{name}_#{base}.cc")}"
    io.puts '        optional: true'
    io.puts '        buildPhase: sources'
    io.puts "        compilerFlags: #{yq(flags.join(' '))}"
  end
end

def emit_ragel_prebuild_script(io, name, ragel_files)
  io.puts '    preBuildScripts:'
  io.puts "      - script: #{yq(%("$SRCROOT/Xcode/scripts/gen_ragel.sh" #{name}))}"
  io.puts "        name: #{yq("Run ragel (#{name})")}"
  io.puts '        outputFiles:'
  ragel_files.each do |rl|
    base = File.basename(rl, '.rl')
    io.puts "          - #{yq("$(DERIVED_FILE_DIR)/_R#{name}_#{base}.cc")}"
  end
end

# vendor/*/default.rave targets: emit_sources's explicit-file-list handling
# (never a directory reference -- Onigmo's own `vendor/` subtree has 60+
# files far outside its `sources` glob, e.g. tests/tools that a directory
# reference would over-include) plus the VENDOR_EXTRA table's per-target
# extra HEADER_SEARCH_PATHS/OTHER_CFLAGS (see the comment above
# VENDOR_EXTRA). None of the 3 vendor targets mix languages (kvdb is all
# .m, Onigmo and xdiff are all .c), so emit_sources's homogeneous path
# always applies here.
def emit_vendor_target(io, target, header_deps)
  name  = target.name
  extra = VENDOR_EXTRA.fetch(name)

  io.puts "  #{name}:"
  io.puts '    type: library.static'
  io.puts '    platform: macOS'
  prefix_header = emit_sources(io, resolved(target.lists['sources']))

  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq(prefix_header)}" if prefix_header
  io.puts header_search_paths_line(header_deps, extra_paths: extra[:search_paths])
  io.puts "        OTHER_CFLAGS: #{yq("$(inherited) #{extra[:other_cflags]}")}" if extra[:other_cflags]
end

def linked_sdks(name, deps, by_name)
  names      = [name] + deps
  frameworks = names.flat_map { |n| by_name[n].lists['frameworks'] }.uniq
  libraries  = names.flat_map { |n| by_name[n].lists['libraries'] }.uniq
  frameworks.map { |f| "#{f}.framework" } + libraries.map { |l| "lib#{l}.tbd" }
end

# vendor/Onigmo/src/setup.c is a bare __attribute__((constructor)) with no
# externally-referenced symbol -- libtool's own build log literally warns
# "'setup.o' has no symbols" -- whose only job is the load-time side effect
# of onig_set_default_syntax(): copying ONIG_SYNTAX_RUBY with
# ONIG_OPTION_ASCII_RANGE turned off, which is what makes \w/\p{Upper}/
# \p{Lower} match non-ASCII letters at all (regexp/tests/t_format_string.cc's
# capitalize() case on "æblegrød" exercises exactly this). bin/rave links
# every object file directly onto each final executable's own command line,
# so setup.o is always present whether or not anything references it.
# XcodeGen's `type: library.static` instead archives Onigmo into a real
# libOnigmo.a via `libtool -static`, and Xcode's final link consults that
# archive with ordinary lazy, reference-driven member selection -- since
# nothing ever takes setup.o's address, the linker never pulls it out of the
# archive, the constructor never runs, and \w silently falls back to
# Onigmo's built-in ASCII-only default syntax. Confirmed empirically: the
# exact same freshly, doubly-clean-rebuilt libOnigmo.a (PCH cache and
# Onigmo.build both removed first, so nothing stale) passes when its .o
# members are linked directly and fails only when consulted as an archive,
# with every other candidate (source-file set, -funsigned-char, -std=c99,
# -Os, -flto=thin/LLVM_LTO, -fno-common, PCH content) ruled out by isolating
# each one in turn against a minimal onig_new/onig_search probe. -force_load
# is Apple's documented fix for exactly this shape of bug: an archive member
# whose only purpose is a linker-invisible side effect. Applied to every
# target whose closure links Onigmo, not just regexp_test -- the same silent
# drop would otherwise ship in TextMate.app itself.
def emit_onigmo_force_load(io, deps)
  return unless deps.include?('Onigmo')

  io.puts "        OTHER_LDFLAGS: #{yq('$(inherited) -force_load $(BUILT_PRODUCTS_DIR)/libOnigmo.a')}"
end

# `tool`-kind targets: a flat, non-bundle Mach-O executable (`executable
# "${target}"`, no `prefix`) -- mate, tm_query, PrivilegedTool, and the two
# tiny CLI helpers each plugin embeds (tm_dialog, tm_dialog2). Structurally
# this is emit_library_target's sources: handling plus emit_test_target's
# linking: unlike a library.static (never linked at its own build step) a
# tool links its own `require` closure directly, exactly like the CxxTest
# runner tool already does -- this is the "frameworks/libraries aggregation
# wired only for _test tool targets" gap Task 5 flagged, generalised here to
# any tool-kind target rather than duplicated.
def emit_tool_target(io, target, deps, header_deps, by_name)
  name = target.name

  io.puts "  #{name}:"
  io.puts '    type: tool'
  io.puts '    platform: macOS'
  prefix_header = emit_sources(io, resolved(target.lists['sources']))

  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq(prefix_header)}" if prefix_header
  io.puts header_search_paths_line(header_deps) unless header_deps.empty?
  emit_onigmo_force_load(io, deps)
  # CommitWindowTool is the first tool-kind target with neither a `require`
  # (deps) nor a `frameworks`/`libraries` line (sdks) -- confirmed against
  # its own build.ninja Link edge, which really does link nothing but
  # libc++/the ObjC runtime. An unconditional `dependencies:` key with
  # nothing indented under it is `nil`, not `[]`, to a YAML parser --
  # XcodeGen rejects that ("Incorrect type, expected Array<Any>"), so the
  # key must be omitted entirely rather than left empty.
  sdks = linked_sdks(name, deps, by_name)
  unless deps.empty? && sdks.empty?
    io.puts '    dependencies:'
    deps.each { |d| io.puts "      - target: #{d}" }
    sdks.each { |sdk| io.puts "      - sdk: #{sdk}" }
  end
end

# `bundle`/`qlgenerator`-kind targets: rave's `add LN_FLAGS "-bundle"` +
# `prefix "${target}.EXT/Contents"` -- Dialog, Dialog2 (.tmplugin) and
# TextMateQL (.qlgenerator). XcodeGen's `type: bundle` produces a generic
# loadable bundle; WRAPPER_EXTENSION is what turns it into the specific
# kind, keyed off kind_of exactly like the dispatch in run_emit_yaml.
#
# Beyond sources/linking (same shape as emit_tool_target), a bundle needs
# what rave's `files`/`copy` directives do that this parser doesn't record
# (see the EMBED comment): expanding Info.plist, converting
# English.lproj/InfoPlist.strings, and -- app only -- everything else under
# Resources/About/SharedSupport. All of that lives in ONE postBuildScripts
# phase, Xcode/scripts/assemble_resources.sh, dispatching on the target
# name; embedding another target's OWN build product (tm_dialog into
# Dialog, TextMateQL into TextMate, etc.) is instead a native `dependencies:
# ... embed: true, copy: {...}` Copy Files phase (emit_embed_dependencies)
# so Xcode orders and re-signs it itself rather than racing a raw `cp -R`
# against the rest of the build.
WRAPPER_EXTENSION_FOR_KIND = { 'bundle' => 'tmplugin', 'qlgenerator' => 'qlgenerator' }.freeze

def emit_bundle_target(io, target, deps, header_deps, by_name)
  name = target.name

  io.puts "  #{name}:"
  io.puts '    type: bundle'
  io.puts '    platform: macOS'
  prefix_header = emit_sources(io, resolved(target.lists['sources']))

  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq(prefix_header)}" if prefix_header
  io.puts "        WRAPPER_EXTENSION: #{WRAPPER_EXTENSION_FOR_KIND.fetch(kind_of(target))}"
  # Real (CODE_SIGNING_ALLOWED not =NO) codesigning refuses to sign a bundle
  # target with no known Info.plist source at all -- "Cannot code sign
  # because the target does not have an Info.plist file" -- a real Task 6
  # build failure that individual per-target `CODE_SIGNING_ALLOWED=NO` test
  # builds never exercise (only a full, actually-signing `-scheme TextMate`
  # build does). Same INFOPLIST_FILE-points-at-the-real-unexpanded-file +
  # postBuildScripts-overwrites-it approach as emit_app_target, derived from
  # the target's own .rave location rather than a second hardcoded table.
  io.puts "        INFOPLIST_FILE: #{yq(File.join(File.dirname(target.file), 'Info.plist'))}"
  io.puts header_search_paths_line(header_deps) unless header_deps.empty?
  emit_onigmo_force_load(io, deps)

  emit_assemble_resources_script(io, name)

  io.puts '    dependencies:'
  # `link: true` is explicit, not relied on as a default: XcodeGen's own
  # doc says static libraries link "to executables" by default, and a
  # `type: bundle` product doesn't count as one for that inference --
  # found empirically (a real Task 6 build failure, not a hypothetical):
  # TextMateQL linked with -framework/-l<vendor library> flags present but
  # every `-l<framework-library>` flag silently absent, "Undefined symbols"
  # for buffer_t/settings_for_path/etc. emit_tool_target's `type: tool`
  # targets never needed this (tool IS "executable" by XcodeGen's default).
  deps.each { |d| io.puts "      - target: #{d}\n        link: true" }
  linked_sdks(name, deps, by_name).each { |sdk| io.puts "      - sdk: #{sdk}" }
  emit_embed_dependencies(io, name)
end

# `app`-kind: TextMate itself, the one target of this kind in the tree
# (Applications/TextMate/default.rave:1-37). Same sources/linking/embed
# shape as emit_bundle_target, minus WRAPPER_EXTENSION (type: application's
# default -- ".app" -- is already right) plus two things only the app needs:
#
# - INFOPLIST_FILE points at the REAL, UNEXPANDED
#   Applications/TextMate/Info.plist so Xcode always has a real file to
#   process (it only substitutes its OWN $(VAR) syntax, so rave's ${VAR}
#   tokens just pass through inertly) -- assemble_resources.sh's
#   postBuildScripts phase then overwrites $TARGET_BUILD_DIR/
#   $CONTENTS_FOLDER_PATH/Info.plist with the properly-expanded version
#   (APP_VERSION from CHANGELOG.md, TARGET_NAME from Xcode's own env,
#   CS_GET_TASK_ALLOW from $CONFIGURATION) before Xcode's implicit final
#   codesign step runs (postBuildScripts are documented to run "after any
#   other build phase", i.e. always before that).
# - CODE_SIGN_ENTITLEMENTS points at a $(DERIVED_FILE_DIR) path the same
#   postBuildScripts phase writes, for the same reason: rave's
#   `expand CS_ENTITLEMENTS` (default.rave:18) needs the same ${VAR}
#   substitution, which CODE_SIGN_ENTITLEMENTS's native handling can't do
#   either.
# Frameworks/network case-collides with Apple's real Network.framework on
# APFS (case-insensitive) -- the SAME class of risk header-strategy.md's
# Task 5 addendum already documents for Xcode's automatic Headers-phase
# copy, but a different mechanism: rave precompiles Shared/PCH/prelude.*
# ONCE, globally, with a fixed, dependency-independent flag set (`prelude
# Shared/PCH/prelude.*` at the ROOT default.rave, never inside any
# target's own `require`-derived flags), so its own `#import <WebKit/
# WebKit.h>` (prelude.m) always resolves against Apple's real
# Network.framework, full stop. Xcode's GCC_PRECOMPILE_PREFIX_HEADER is
# inherently PER-TARGET -- it precompiles prelude.mm fresh for every
# target using that target's OWN HEADER_SEARCH_PATHS -- so the first
# target whose closure both requires `network` AND forces prelude.mm
# (TextMate: `require ... network ...` alongside its mixed .cc+.mm
# sources) hits a real, reproduced build failure: `#import <Network/
# Network.h>` (from WebKit.h) resolves through
# $(SRCROOT)/Xcode/include/network -- APFS treats that path's own
# `network/` subdirectory as equal to `Network/` -- shadowing Apple's
# framework with ours ("no template named 'map' in namespace 'std'",
# since our network/constants.h compiles with no PCH context). Excluded
# here rather than fixed at the farm level (a bigger, riskier change
# touching all 76 already-verified targets): TextMate's own sources
# (Applications/TextMate/src/*.mm) never `#include <network/...>`
# directly (grepped, zero matches) -- `network` is only in TextMate's
# `require` for LINKING (BundlesManager/SoftwareUpdate need it), which
# `dependencies:` (unaffected by this) already provides.
APP_HEADER_SEARCH_EXCLUDE = %w[network].freeze

def emit_app_target(io, target, deps, header_deps, by_name)
  name = target.name
  header_deps = header_deps - APP_HEADER_SEARCH_EXCLUDE

  io.puts "  #{name}:"
  io.puts '    type: application'
  io.puts '    platform: macOS'
  prefix_header = emit_sources(io, resolved(target.lists['sources']))

  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq(prefix_header)}" if prefix_header
  io.puts "        INFOPLIST_FILE: #{yq('Applications/TextMate/Info.plist')}"
  io.puts header_search_paths_line(header_deps) unless header_deps.empty?
  emit_onigmo_force_load(io, deps)

  # Entitlements.plist (default.rave:18 `expand CS_ENTITLEMENTS`) needs the
  # same ${VAR} substitution as Info.plist, but CANNOT be generated by a
  # build-time script the way Info.plist is (emit_assemble_resources_script,
  # postBuildScripts): CODE_SIGN_ENTITLEMENTS feeds Xcode's
  # ProcessProductPackaging step, which participates in the dependency graph
  # far earlier than a bundle's Resources. Three real, distinct build
  # failures came out of trying anyway (in order): "Entitlements file ...
  # was modified during the build" (postBuildScripts -- too late);
  # "Multiple commands produce ... Entitlements.plist" (preBuildScripts
  # writing under $(DERIVED_FILE_DIR), same filename Xcode stages
  # internally); "Cycle inside TextMate" (preBuildScripts writing under
  # $(DERIVED_FILE_DIR) even with a different filename -- Xcode treats
  # anything CODE_SIGN_ENTITLEMENTS points to THERE as a node it's also
  # responsible for producing). Fixed by not generating it at Xcode BUILD
  # time at all: XcodeGen's own native `entitlements:` key (ProjectSpec.md's
  # Plist section, verified against the installed 2.46.0's actual behaviour)
  # writes the file at `xcodegen generate` time -- the same point project.yml
  # itself gets turned into TextMate.xcodeproj -- so by the time xcodebuild
  # ever runs, it is just an ordinary, already-existing file, with no
  # build-graph timing question at all. This DOES mean CS_GET_TASK_ALLOW is
  # fixed at generation time rather than reading $CONFIGURATION at build
  # time (rave's own config debug/release split, default.rave:10-16) --
  # hardcoded to Release's value (false) here, since Release is this task's
  # verification target and Xcode's own ad-hoc local-signing already adds
  # get-task-allow=1 unconditionally regardless (observed on `mate`, which
  # has no entitlements wired at all), making the Debug value moot in
  # practice for a local, non-distribution build either way.
  io.puts '    entitlements:'
  io.puts "      path: #{yq('Xcode/generated/TextMate.entitlements')}"
  io.puts '      properties:'
  io.puts '        com.apple.security.automation.apple-events: true'
  io.puts '        com.apple.security.personal-information.addressbook: true'
  io.puts '        com.apple.security.cs.disable-library-validation: true'
  io.puts '        com.apple.security.get-task-allow: false'

  emit_assemble_resources_script(io, name)

  io.puts '    dependencies:'
  deps.each { |d| io.puts "      - target: #{d}\n        link: true" }
  linked_sdks(name, deps, by_name).each { |sdk| io.puts "      - sdk: #{sdk}" }
  emit_embed_dependencies(io, name)
end

# assemble_resources.sh (re)writes hundreds of files under Resources/About/
# SharedSupport for TextMate and touches Info.plist/Entitlements for all
# four bundle-like targets -- declaring an accurate `outputFiles:` list
# isn't practical (support/* alone is 246 files that can each change
# independently), so this is explicitly "always run" rather than XcodeGen's
# default dependency-analysed script phase, which would otherwise print
# "will be run during every build because it does not specify any outputs"
# on every invocation -- accurate as a description, not useful as a warning
# once the reason is understood, so it's silenced by stating the true
# intent (`basedOnDependencyAnalysis: false`) instead of inventing an
# output-file list that wouldn't actually gate anything correctly.
def emit_assemble_resources_script(io, name)
  io.puts '    postBuildScripts:'
  io.puts "      - script: #{yq(%("$SRCROOT/Xcode/scripts/assemble_resources.sh" #{name}))}"
  io.puts "        name: #{yq("Assemble resources (#{name})")}"
  io.puts '        basedOnDependencyAnalysis: false'
end

# The generated CxxTest runner's own extension must match bin/rave's choice
# (bin/rave:1392: any .mm/.m test source promotes the WHOLE runner to .mm,
# since bin/gen_test textually concatenates every t_*.{cc,mm} file's body
# into one generated translation unit -- ObjC++ is a superset of C++, so one
# .mm runner safely holds both kinds of test bodies, but a .cc runner cannot
# hold Objective-C++ syntax). Xcode/scripts/gen_test.sh must compute this
# exact same extension for its output filename to agree with what this
# function tells Xcode to expect.
def test_runner_ext(target)
  resolved(target.lists['tests']).any? { |f| f.end_with?('.mm', '.m') } ? '.mm' : '.cc'
end

def emit_test_target(io, target, deps, header_deps, by_name)
  name = target.name
  ext  = test_runner_ext(target)

  generated = "$(DERIVED_FILE_DIR)/_T#{name}#{ext}"

  io.puts "  #{name}_test:"
  io.puts '    type: tool'
  io.puts '    platform: macOS'
  io.puts '    sources:'
  io.puts "      - path: #{yq(generated)}"
  io.puts '        optional: true'
  io.puts '        buildPhase: sources'
  io.puts '    preBuildScripts:'
  io.puts "      - script: #{yq(%("$SRCROOT/Xcode/scripts/gen_test.sh" #{name}))}"
  io.puts "        name: #{yq("Generate CxxTest runner (#{name})")}"
  io.puts '        outputFiles:'
  io.puts "          - #{yq(generated)}"
  io.puts '    settings:'
  io.puts '      base:'
  io.puts "        GCC_PREFIX_HEADER: #{yq("$(SRCROOT)/Shared/PCH/#{PRELUDE_FOR_EXT.fetch(ext)}")}"
  io.puts header_search_paths_line(header_deps, extra_paths: ["$(SRCROOT)/Xcode/include/#{name}"])
  # `deps` is transitive_requires(name), which never includes name itself --
  # irrelevant for every OTHER _test target (Onigmo is reached transitively,
  # already in deps), but Onigmo_test's own `deps` is empty (Onigmo has no
  # `require`) even though it links Onigmo directly via the dependency line
  # just below. `+ [name]` covers that one case without a separate branch.
  emit_onigmo_force_load(io, deps + [name])
  io.puts '    dependencies:'
  io.puts "      - target: #{name}"
  deps.each { |d| io.puts "      - target: #{d}" }
  linked_sdks(name, deps, by_name).each { |sdk| io.puts "      - sdk: #{sdk}" }
end

# `files @X`/`copy @X` lines reference ANOTHER target's OWN build product
# (already built, in Dialog/Dialog2's case already codesigned) and embed it
# at a bundle-relative path -- a different edge than `require` (which links
# .o's/.a's into the CURRENT target). The parser doesn't record `files`/
# `copy` arguments at all (both are INERT_DIRECTIVES -- variable/resource
# plumbing no target before Task 6 ever needed translated, see the comment
# there), so -- same rationale as VENDOR_EXTRA -- this is a small, hand-built
# table rather than a new generic directive shape, verified by hand against
# EVERY `files`/`copy` line in the tree (grepped exhaustively across
# Frameworks/Applications/PlugIns/vendor, not just the app's own
# default.rave) rather than parsed:
#
#   Applications/TextMate/default.rave:26-32  files/copy @PrivilegedTool
#     @mate @tm_query @Dialog @Dialog2 @TextMateQL
#   PlugIns/dialog-1.x/default.rave:13         files @tm_dialog
#   PlugIns/dialog/default.rave:13             files @tm_dialog2
#   Frameworks/CommitWindow/default.rave:5     files @CommitWindowTool "MacOS"
#
# CommitWindowTool is keyed under 'TextMate', not 'CommitWindow', even
# though the `files` line lives in CommitWindow's own default.rave: rave's
# bin/rave:1097 signature() walks `required_targets(target, ..., include_
# self: true)` -- target ITSELF PLUS everything it transitively requires --
# and folds every one of THEIR OWN `files`/`copy` assets into target's
# bundle. TextMate `require`s CommitWindow (Applications/TextMate/
# default.rave:2), so CommitWindowTool lands in TextMate.app/Contents/
# MacOS/ despite never being named in TextMate's own default.rave at all --
# confirmed against the ninja artifact baseline, which was missing exactly
# this one entry (29 executables instead of 30 under TextMate.app) until
# this line was added. CommitWindow itself has no `prefix`/bundle of its
# own (it is a plain library), so it never calls emit_embed_dependencies --
# only a target keyed here, i.e. one XcodeGen actually copies files into,
# does.
#
# Embedded names are added to the SAME closure as ordinary `require` deps
# (see add_to_closure) so each gets its own library.static/tool/bundle
# block; emit_app_target/emit_bundle_target consume this table again,
# separately, to know which dependency edges are "embed via Copy Files"
# (destination + subpath, see the comment there) rather than "link".
EMBED = {
  'TextMate' => %w[PrivilegedTool mate tm_query Dialog Dialog2 TextMateQL CommitWindowTool],
  'Dialog'   => %w[tm_dialog],
  'Dialog2'  => %w[tm_dialog2],
}.freeze

# Where each EMBED value lands, as an XcodeGen dependency `copy:` block
# (destination + subpath -- see the Dependency section of XcodeGen's own
# ProjectSpec.md, verified against the installed 2.46.0 empirically since
# this tree has no cached copy of that doc). `destination:` values are
# XcodeGen's fixed enum (dstSubfolderSpec names), matching each `files`/
# `copy` destination string in EMBED's own comment: "MacOS" -> executables,
# "Resources" -> resources, "PlugIns" -> plugins.
#
# `wrapper` means the PRODUCT ROOT (TextMate.app/ itself), NOT Contents/ --
# a real build failure ("unsealed contents present in the bundle root")
# caught this the first time: `subpath: 'Library/QuickLook'` alone put
# TextMateQL.qlgenerator at TextMate.app/Library/QuickLook/, a stray
# top-level entry outside Contents/ that codesign refuses to seal. `wrapper`
# is still the right destination (none of the other named enum values reach
# Library/QuickLook, and Contents/ is just an ordinary subdirectory of the
# wrapper from the build system's point of view even though the OS treats it
# specially) -- the subpath just needs "Contents/" spelled out explicitly.
EMBED_DESTINATION = {
  'PrivilegedTool'   => { destination: 'resources', subpath: nil },
  'mate'             => { destination: 'executables', subpath: nil },
  'tm_query'         => { destination: 'executables', subpath: nil },
  'Dialog'           => { destination: 'plugins', subpath: nil },
  'Dialog2'          => { destination: 'plugins', subpath: nil },
  'TextMateQL'       => { destination: 'wrapper', subpath: 'Contents/Library/QuickLook' },
  'tm_dialog'        => { destination: 'resources', subpath: nil },
  'tm_dialog2'       => { destination: 'resources', subpath: nil },
  'CommitWindowTool' => { destination: 'executables', subpath: nil },
}.freeze

# `embed: true` is XcodeGen's default for an application target's `target:`
# dependency but NOT for a bundle target's (Dialog/Dialog2 embedding
# tm_dialog/tm_dialog2), so it's spelled out explicitly here rather than
# relied on either way. `link: false` because none of these eight are ever
# meant to be linked into the embedder's own Mach-O -- only copied in, same
# as rave's `files @X`/`copy @X` (asset copying, never a link input; see
# Target.assets in the header-strategy doc). `codeSign: true` (also the
# default) matches rave codesigning each embedded bundle independently
# before it's ever copied into the outer bundle (Target.signature's own
# `required_targets(..., include_self: true)` + assets loop) -- Xcode's
# Copy Files "Code Sign on Copy" does the equivalent re-sign-after-copy.
def emit_embed_dependencies(io, name)
  EMBED.fetch(name, []).each do |embedded|
    dest = EMBED_DESTINATION.fetch(embedded)
    io.puts "      - target: #{embedded}"
    io.puts '        embed: true'
    io.puts '        codeSign: true'
    io.puts '        link: false'
    io.puts '        copy:'
    io.puts "          destination: #{dest[:destination]}"
    io.puts "          subpath: #{yq(dest[:subpath])}" if dest[:subpath]
  end
end

# Adds `name` and its full require/require_headers closure to `closure`,
# recursing into EMBED so e.g. requesting just "TextMate" also pulls in
# Dialog -> tm_dialog transitively, each validated (and each one's OWN
# `require` closure walked) via the ordinary top_level machinery. Guarded
# by the `closure[name]` check so a name reachable both as an embed and as
# an ordinary requirement (none today, but EMBED's targets could in
# principle also appear in some other target's `require`) is only ever
# processed once.
def add_to_closure(name, closure, by_name)
  return if closure[name]
  checked_target(name, by_name, top_level: true)
  closure[name] = true
  transitive_requires(name, by_name).each_key { |dep| closure[dep] = true }
  transitive_header_deps(name, by_name).each_key { |dep| closure[dep] = true }
  EMBED.fetch(name, []).each { |embedded| add_to_closure(embedded, closure, by_name) }
end

def run_emit_yaml(target_names, io)
  by_name = all_targets_by_name

  closure = {} # name => true, every target needing its own Xcode target block
  target_names.each { |start| add_to_closure(start, closure, by_name) }

  io.puts "# generated by bin/rave2yaml --emit-yaml #{target_names.join(' ')} -- do not hand-edit"
  io.puts '---'
  io.puts 'name: TextMate'
  io.puts 'options:'
  io.puts '  createIntermediateGroups: true'
  io.puts 'configFiles:'
  io.puts '  Debug: Xcode/Base.xcconfig'
  io.puts '  Release: Xcode/Base.xcconfig'
  io.puts 'settings:'
  io.puts '  base:'
  io.puts '    CLANG_CXX_LANGUAGE_STANDARD: c++20' # base.yml preset ships gnu++14; override wins, see Base.xcconfig
  io.puts '    GCC_C_LANGUAGE_STANDARD: c99'        # base.yml preset ships gnu11; override wins, see Base.xcconfig
  io.puts 'targets:'
  closure.each_key do |name|
    target      = by_name[name]
    deps        = transitive_requires(name, by_name).keys
    header_deps = transitive_header_deps(name, by_name).keys
    # emit_test_target stays a single unconditional-tail call (matching the
    # pre-Task-6 shape) rather than living inside the 'framework' branch --
    # vendor targets can declare tests too (Onigmo does), so nesting it
    # under one kind's branch would silently drop Onigmo_test.
    if target.vendor
      emit_vendor_target(io, target, header_deps)
    elsif kind_of(target) == 'framework'
      emit_library_target(io, target, header_deps)
    elsif kind_of(target) == 'tool'
      emit_tool_target(io, target, deps, header_deps, by_name)
    elsif %w[bundle qlgenerator].include?(kind_of(target))
      emit_bundle_target(io, target, deps, header_deps, by_name)
    elsif kind_of(target) == 'app'
      emit_app_target(io, target, deps, header_deps, by_name)
    else
      raise RaveError, "--emit-yaml: #{name}: kind '#{kind_of(target)}' reached the emission " \
                        'dispatch with no emitter wired yet'
    end
    emit_test_target(io, target, deps, header_deps, by_name) unless target.lists['tests'].empty?
  end
end

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename(__FILE__)} --inventory | --emit-header-farm | --emit-yaml <target>..."
  opts.on('--inventory', 'Print a human-readable inventory of every .rave target.') do
    options[:inventory] = true
  end
  opts.on('--emit-header-farm', 'Write the Xcode/include/<name>/<name> symlink farm.') do
    options[:emit_header_farm] = true
  end
  opts.on('--emit-yaml', 'Print an XcodeGen project.yml for the given targets plus their transitive require closure.') do
    options[:emit_yaml] = true
  end
  opts.on('-h', '--help', 'Show this help.') do
    puts opts
    exit
  end
end
parser.parse!

begin
  if options[:inventory]
    run_inventory($stdout)
  elsif options[:emit_header_farm]
    run_header_farm($stdout)
  elsif options[:emit_yaml]
    raise RaveError, '--emit-yaml needs at least one target name' if ARGV.empty?
    run_emit_yaml(ARGV, $stdout)
  else
    warn parser.banner
    exit 1
  end
rescue RaveError => e
  warn "rave2yaml: #{e.message}"
  exit 1
end
