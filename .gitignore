# ---- Build output ----
build/
build.ninja
.ninja_deps
.ninja_log
DerivedData/
*.o
*.dSYM/

# ---- Xcode project, generated by `xcodegen generate --spec project.yml` ----
# project.yml is the checked-in source of truth; the .xcodeproj it produces
# is regenerated on demand, same relationship as build.ninja to the .rave
# files above. Xcode/generated/ is XcodeGen's own `entitlements:` plist
# output (TextMate.entitlements, written fresh on every `xcodegen generate`,
# same lifecycle as the .xcodeproj itself -- not the app's real, committed
# Applications/TextMate/Entitlements.plist source).
*.xcodeproj/
Xcode/generated/

# ---- Machine-local build config ----
local.rave

# ---- Legacy upstream artifact ----
Frameworks/license/src/revoked_serials.cc

# ---- Xcode user state ----
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
.swiftpm/

# ---- macOS ----
.DS_Store

